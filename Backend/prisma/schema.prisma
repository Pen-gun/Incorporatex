generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  DRAFT
  SUBBMITTED
}

model Company {
  id String @id @default(uuid())
  name String
  numberOfShareholders Int
  totalCapitalInvested Decimal @db.Decimal(18, 2)
  status CompanyStatus @default(DRAFT)
  shareholders Shareholder[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shareholder {
  id String @id @default(uuid())
  firstName String
  lastName String
  nationality String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, firstName, lastName])
  @@index([companyId])
}